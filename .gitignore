# Machine-local state that has to travel between the desktop and the laptop but must never
# reach git: Claude Code's project memory (which holds FTP and DB credentials in plain text)
# and copies of the global instruction files. Synced with Syncthing, see _local/README.md.
/_local/

# Claude Code's per-machine permission list. Local to whoever runs the agent, nothing the
# project depends on.
/.claude/settings.local.json

# Emulator verification captures. Throwaway evidence for a single session (12 MB and growing);
# the analysis documents describe what was checked, the images add nothing to the repo.
/analysis/screenshots/
SHIFT - работа над игрой/

# Tarot artwork drafts (~75 MB of 1024x1536 PNGs). Source images live outside the repo;
# whatever ships in the game goes into res/ or onto the server instead.
/Карты/
__pycache__/

