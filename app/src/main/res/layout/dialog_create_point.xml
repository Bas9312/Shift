<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/create_point_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvCoordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_coordinates_label"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_type_spinner_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerPointType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvDescriptionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_description_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/point_description_hint"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4"
        android:layout_marginBottom="16dp" />

    <!-- Спиннер для выбора фамильяра (показывается только для типа FAMILIAR) -->
    <TextView
        android:id="@+id/tvFamiliarLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_familiar_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/spinnerFamiliar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvTextToShowLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_text_on_enter_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etTextToShowOnEnter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/point_text_on_enter_hint"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvExpireLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_expire_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etExpireMinutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/point_expire_hint"
        android:inputType="number"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnCreatePoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_create_button"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:textColor="@android:color/white" />

</LinearLayout>
