<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/create_point_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvCoordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_coordinates_label"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_type_spinner_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinnerPointType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvDescriptionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_description_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/point_description_hint"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4"
        android:layout_marginBottom="16dp" />

    <!-- Спиннер для выбора фамильяра (показывается только для типа FAMILIAR) -->
    <TextView
        android:id="@+id/tvFamiliarLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_familiar_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/spinnerFamiliar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvTextToShowLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_text_on_enter_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etTextToShowOnEnter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/point_text_on_enter_hint"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvExpireLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_expire_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etExpireMinutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/point_expire_hint"
        android:inputType="number"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/cbCustomRadius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_custom_radius_label"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvRadiusValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_radius_current"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderRadius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        app:labelBehavior="gone"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/cbCustomCreatedAt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_custom_created_at_label"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvCreatedAtValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_created_at_current"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutCreatedAtPickers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <NumberPicker
            android:id="@+id/npDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <NumberPicker
            android:id="@+id/npHour"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <NumberPicker
            android:id="@+id/npMinute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/cbHidden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_hidden_label"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnCreatePoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_create_button"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:textColor="@android:color/white" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
