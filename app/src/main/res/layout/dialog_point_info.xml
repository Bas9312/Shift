<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvPointTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Информация о точке"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvPointType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Тип: "
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPointRadius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Радиус: "
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPointCoordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Координаты: "
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPointDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Описание: "
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnDeletePoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Удалить точку"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textColor="@android:color/white" />

</LinearLayout>
