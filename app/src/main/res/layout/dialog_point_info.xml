<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvPointTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_info_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvPointType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_radius_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPointRadius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_coordinates_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPointCoordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoLink="web|email|phone"
        android:linksClickable="true"
        android:text="@string/point_description_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPointDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoLink="web|email|phone"
        android:linksClickable="true"
        android:text="@string/point_text_on_enter_label"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPointTextToShowOnEnter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnDeletePoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/point_delete_button"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textColor="@android:color/white" />

</LinearLayout>
