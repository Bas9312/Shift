<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:title="Shift"
        app:menu="@menu/main_menu" />

    <!-- Лоадер для загрузки профиля -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_profile"
            android:textSize="18sp"
            android:gravity="center" />

    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:scrollbars="vertical">

    <!-- Основной контент -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Состояние персонажа"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/inGameSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:weightSum="2"
        app:selectionRequired="true"
        app:singleSelection="true">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/inGame"
        style="@style/selector_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="В игре" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/outGame"
        style="@style/selector_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Не в игре" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenMap"
        android:text="Открыть карту"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openTerminalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Открыть терминал"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openAuraButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Просмотр ауры"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleAuraHidden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Скрыть ауру"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Профиль"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanArtifact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Познать артефакт"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFamiliar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Фамильяр"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRitual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Я провёл ритуал"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <!-- Кнопки для МГ пользователей -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAuraEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Редактор Ауры"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateArtifact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Создать артефакт"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnArtifactPassport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/artifact_passport_button"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMgProfileView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Просмотр профиля"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <!-- Эффекты (только для обычных игроков) -->
    <LinearLayout
        android:id="@+id/effectsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_effects_section"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_effects"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/effectsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

    </LinearLayout>

    </LinearLayout>

</ScrollView>

</LinearLayout> 